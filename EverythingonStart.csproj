<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>EverythingonStart</AssemblyName>
    <RootNamespace>EverythingonStart</RootNamespace>
    <Version>1.5.3</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
    <Description>Windows 11 开始菜单搜索极速复刻启动器，直连 Everything 实时索引并支持自适应缩放、自定义筛选器与双模式 Win 键触发。</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\AppIcon.ico" />
    <EmbeddedResource Include="Assets\Pinyin\pinyin.txt" LogicalName="EverythingonStart.Pinyin.txt" />
    <EmbeddedResource Include="LICENSE" LogicalName="EverythingonStart.Licenses.GPL-3.0.txt" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.md" LogicalName="EverythingonStart.Licenses.ThirdParty.md" />
    <EmbeddedResource Include="licenses\*.txt" LogicalName="EverythingonStart.Licenses.%(Filename)%(Extension)" />
    <None Include="Native\Everything3.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Everything3.dll</Link>
    </None>
    <None Include="Native\Everything64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Everything64.dll</Link>
    </None>
  </ItemGroup>

</Project>
