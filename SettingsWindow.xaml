                                              Checked="OnGaussianBlurOptionChanged" Unchecked="OnGaussianBlurOptionChanged" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="模糊半径由 DWM 管理：" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider x:Name="SldGaussianBlurRadius" Visibility="Collapsed" Grid.Column="1" Minimum="6" Maximum="40" Value="20"
                                                TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="False" ValueChanged="OnSliderValueChanged" />
                                        <TextBlock x:Name="TxtGaussianBlurRadiusVal" Visibility="Collapsed" Grid.Column="2" Text="20" Foreground="{DynamicResource Theme.AccentTextBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="由 DWM/Accent 实时合成背景，支持 Wallpaper Engine 等动态壁纸参与系统合成；不截屏、不读取 GIF/图片预览、不注入其他进程。模糊半径由系统决定，可用背景不透明度调节染色强度；系统不可用时回退原背景。"
                                               Foreground="{DynamicResource Theme.TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="窗口尺寸与多设备自适应缩放"
                                               Foreground="{DynamicResource Theme.TextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

