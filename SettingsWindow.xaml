                                                  Height="30"
                                                  SelectionChanged="OnInitialSearchItemComboChanged">
                                            <ComboBoxItem Content="默认：全部" ToolTip="每次打开搜索面板时回到“全部”分类" />
                                            <ComboBoxItem Content="记住上次分类" ToolTip="恢复上次关闭或退出时选中的搜索分类" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="导航按钮、全屏任务栏与焦点行为"
                                               Foreground="{DynamicResource Theme.TextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                    <CheckBox x:Name="ChkBackButtonClosesOnAll"
                                              Content="在“全部”分类点击返回键时关闭面板"
                                              ToolTip="在其他分类中，返回键仍然切换到“全部”" />
                                    <CheckBox x:Name="ChkKeepTaskbarInFullscreen"
                                              Content="全屏应用中打开搜索时保留任务栏" />
                                    <CheckBox x:Name="ChkEscClearsFirst"
