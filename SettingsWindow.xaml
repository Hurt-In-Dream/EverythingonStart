                            <TextBlock Text="设置 Win 键行为，以及搜索面板的打开和关闭方式。" Foreground="{DynamicResource Theme.TextMutedBrush}" FontSize="12" Margin="0,5,0,18" />
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Win 键呼出模式与初始搜索项"
                                               Foreground="{DynamicResource Theme.TextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="165" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Win 键触发方式：" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbTriggerMode" Grid.Column="1" Height="30">
