                                    <CheckBox x:Name="ChkClearSearchOnOpen"
                                              Content="每次呼出搜索窗口时自动清空上一次的搜索词" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 分页 4：外观尺寸与系统 -->
                        <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                            <TextBlock Text="外观与系统" Foreground="{DynamicResource Theme.TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="调整窗口外观，管理启动方式与 Everything 路径。" Foreground="{DynamicResource Theme.TextMutedBrush}" FontSize="12" Margin="0,5,0,18" />
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="主题与配色" Foreground="{DynamicResource Theme.TextPrimaryBrush}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,10" />
