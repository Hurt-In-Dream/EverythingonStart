                                <StackPanel>
                                    <TextBlock Text="排序方式与附加类型筛选"
                                               Foreground="{DynamicResource Theme.TextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="165" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Everything 结果排序方式：" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbSortOrder" Grid.Column="1" Height="30">
                                            <ComboBoxItem Content="跟随 Everything 设置 (读取 Everything.ini)" />
                                            <ComboBoxItem Content="智能默认 (运行次数优先 + 名称升序)" />
                                            <ComboBoxItem Content="名称 (A → Z 升序)" />
                                            <ComboBoxItem Content="名称 (Z → A 降序)" />
                                            <ComboBoxItem Content="修改时间 (最新修改优先)" />
                                            <ComboBoxItem Content="修改时间 (最早修改优先)" />
                                            <ComboBoxItem Content="创建时间 (最新创建优先)" />
                                            <ComboBoxItem Content="创建时间 (最早创建优先)" />
                                            <ComboBoxItem Content="文件大小 (从大到小)" />
                                            <ComboBoxItem Content="文件大小 (从小到大)" />
                                            <ComboBoxItem Content="路径 (A → Z 升序)" />
                                            <ComboBoxItem Content="路径 (Z → A 降序)" />
                                            <ComboBoxItem Content="文件扩展名 (A → Z 升序)" />
                                            <ComboBoxItem Content="运行次数 (从高到低)" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="165" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="当前附加文件类型筛选：" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbExtraTypeFilter" Grid.Column="1" Height="30">
                                            <ComboBoxItem Content="不限附加类型 (显示全部匹配项)" />
                                            <ComboBoxItem Content="仅音频文件 (Audio)" />
                                            <ComboBoxItem Content="仅视频文件 (Video)" />
                                            <ComboBoxItem Content="仅压缩包文件 (Compressed)" />
                                            <ComboBoxItem Content="仅可执行程序 (Executable)" />
                                            <ComboBoxItem Content="仅代码与脚本文件 (Code)" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Everything 搜索匹配修饰项"
                                               Foreground="{DynamicResource Theme.TextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                    <CheckBox x:Name="ChkFollowEverythingFlags"
                                              Content="跟随 Everything 配置文件 (Everything.ini) 中的匹配选项"
                                              Checked="OnFollowFlagsChanged"
                                              Unchecked="OnFollowFlagsChanged" />
                                    <CheckBox x:Name="ChkMatchCase" Content="区分大小写 (Match Case)" />
                                    <CheckBox x:Name="ChkMatchWholeWord" Content="全字匹配 (Match Whole Word)" />
                                    <CheckBox x:Name="ChkMatchPath" Content="匹配完整路径 (Match Path)" />
                                    <CheckBox x:Name="ChkEnableRegex" Content="启用正则表达式 (Enable Regex)" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="搜索结果条数与联机数据源"
                                               Foreground="{DynamicResource Theme.TextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="“全部”视图每组最大显示条数：" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" />
