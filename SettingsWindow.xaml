                                    <TextBox x:Name="TxtCustomAudioFilter" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,8" />

                                    <TextBlock Text="视频文件扩展名：" Foreground="{DynamicResource Theme.TextMutedBrush}" FontSize="11.5" Margin="0,2,0,4" />
                                    <TextBox x:Name="TxtCustomVideoFilter" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,8" />

                                    <TextBlock Text="压缩包文件扩展名：" Foreground="{DynamicResource Theme.TextMutedBrush}" FontSize="11.5" Margin="0,2,0,4" />
                                    <TextBox x:Name="TxtCustomCompressedFilter" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,8" />

                                    <TextBlock Text="代码与脚本文件扩展名：" Foreground="{DynamicResource Theme.TextMutedBrush}" FontSize="11.5" Margin="0,2,0,4" />
                                    <TextBox x:Name="TxtCustomCodeFilter" Style="{StaticResource DarkTextBoxStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 分页 2：排序与搜索选项 -->
                        <StackPanel x:Name="PageSortAndSearch" Visibility="Collapsed">
