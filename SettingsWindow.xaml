                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="手动固定缩放倍率：" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider x:Name="SldManualScale" Grid.Column="1" Minimum="75" Maximum="125" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnSliderValueChanged" />
                                        <TextBlock x:Name="TxtManualScaleVal" Grid.Column="2" Text="100%" Foreground="{DynamicResource Theme.AccentTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Margin="0,2,0,0">
                                        <Button Content="重新检测开始菜单尺寸" HorizontalAlignment="Left"
                                                Style="{StaticResource DarkActionButtonStyle}"
                                                Click="OnReprobeStartMenuSizeClick" />
                                        <TextBlock x:Name="TxtCurrentBoundsSource"
                                                   Foreground="{DynamicResource Theme.TextMutedBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                    Margin="0,8,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="视觉透明度与动画效果"
                                               Foreground="{DynamicResource Theme.TextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="主面板背景不透明度：" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider x:Name="SldWindowOpacity" Grid.Column="1" Minimum="75" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnSliderValueChanged" />
                                        <TextBlock x:Name="TxtWindowOpacityVal" Grid.Column="2" Text="95%" Foreground="{DynamicResource Theme.AccentTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <CheckBox x:Name="ChkEnablePopupAnim" Content="启用搜索面板弹出时的平滑上浮与缩放缓动动画" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="系统启动与 Everything 路径集成"
                                               Foreground="{DynamicResource Theme.TextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                    <CheckBox x:Name="ChkAutostart" Content="开机自动启动 EverythingonStart 并常驻系统托盘" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="175" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Everything 命名实例名：" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBox x:Name="TxtInstanceName" Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}" ToolTip="留空将自动探测默认实例与 1.5a 实例" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="175" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Everything.exe 程序路径：" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBox x:Name="TxtEverythingExePath" Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,8,0" ToolTip="留空将自动检索本机 Everything.exe" />
                                        <Button Grid.Column="2" Content="浏览..." Style="{StaticResource DarkActionButtonStyle}" Click="OnBrowseEverythingExeClick" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="175" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Everything Filters.csv 路径：" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBox x:Name="TxtFiltersCsvPath" Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,8,0" ToolTip="留空将自动读取 %APPDATA%\Everything\Filters.csv" />
                                        <Button Grid.Column="2" Content="浏览..." Style="{StaticResource DarkActionButtonStyle}" Click="OnBrowseFiltersCsvClick" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- 底部操作栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Theme.SurfaceBrush}"
                    CornerRadius="0,0,12,12"
                    BorderBrush="{DynamicResource Theme.Alpha1ABrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                             Content="恢复默认类型"
                            Style="{StaticResource DarkActionButtonStyle}"
                            Margin="0,0,8,0"
                            Click="OnResetDefaultFiltersClick" />

                    <Button Grid.Column="1"
                             Content="重新同步 Everything"
                            Style="{StaticResource DarkActionButtonStyle}"
                            Click="OnResyncEverythingConfigClick" />

                    <Button Grid.Column="3"
                            Content="取消"
                            Style="{StaticResource DarkActionButtonStyle}"
                            Width="86"
                            Margin="0,0,10,0"
                            Click="OnCloseButtonClick" />

                    <Button Grid.Column="4"
                            Content="保存并应用"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="110"
                            Click="OnSaveAndApplyClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
