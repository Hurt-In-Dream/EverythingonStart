                                        <TextBlock x:Name="TxtMaxPerGroupVal" Grid.Column="2" Text="6" Foreground="{DynamicResource Theme.AccentTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="单分类页面最大加载结果数：" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider x:Name="SldMaxSingleCategory" Grid.Column="1" Minimum="30" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnSliderValueChanged" />
                                        <TextBlock x:Name="TxtMaxSingleCategoryVal" Grid.Column="2" Text="120" Foreground="{DynamicResource Theme.AccentTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="165" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="默认 Web 搜索引擎：" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbWebSearchEngine" Grid.Column="1" Height="30">
                                            <ComboBoxItem Content="Bing (必应)" />
                                            <ComboBoxItem Content="Google" />
                                            <ComboBoxItem Content="百度 (Baidu)" />
                                            <ComboBoxItem Content="DuckDuckGo" />
                                        </ComboBox>
                                    </Grid>

                                    <CheckBox x:Name="ChkShowWebInAll" Content="在“全部”分类视图中显示联机 Web 搜索建议" />
                                    <CheckBox x:Name="ChkShowSettingsInAll" Content="在“全部”分类视图中显示 Windows 系统设置项" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 分页 3：呼出与交互设置 -->
