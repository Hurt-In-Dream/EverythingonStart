<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Compile Include="StartMenuIndex.Regression.cs.txt" />
    <Reference Include="EverythingonStart">
      <HintPath>$(AppAssemblyDirectory)\EverythingonStart.dll</HintPath>
    </Reference>
    <Reference Include="HtmlAgilityPack">
      <HintPath>$(AppAssemblyDirectory)\HtmlAgilityPack.dll</HintPath>
    </Reference>
    <Reference Include="$(AppAssemblyDirectory)\Vanara.*.dll" />
    <None Include="$(AppAssemblyDirectory)\Everything3.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(AppAssemblyDirectory)\Everything64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
