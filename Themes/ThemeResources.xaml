<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Theme.WindowBackgroundBrush" Color="#1E2024" />
    <SolidColorBrush x:Key="Theme.SearchShadowBrush" Color="#1F2023" />
    <SolidColorBrush x:Key="Theme.SearchBackgroundBrush" Color="#F21F2023" />
    <SolidColorBrush x:Key="Theme.SurfaceBrush" Color="#23252A" />
    <SolidColorBrush x:Key="Theme.CardBrush" Color="#27292E" />
    <SolidColorBrush x:Key="Theme.InputBrush" Color="#1A1B1E" />
    <SolidColorBrush x:Key="Theme.ControlBrush" Color="#1C1F24" />
    <SolidColorBrush x:Key="Theme.ButtonBrush" Color="#32353E" />
    <SolidColorBrush x:Key="Theme.HoverBrush" Color="#3E424D" />
    <SolidColorBrush x:Key="Theme.PressedBrush" Color="#282A30" />
    <SolidColorBrush x:Key="Theme.BorderBrush" Color="#454B55" />
    <SolidColorBrush x:Key="Theme.StrongBorderBrush" Color="#697381" />
    <SolidColorBrush x:Key="Theme.TextPrimaryBrush" Color="#F3F5F8" />
    <SolidColorBrush x:Key="Theme.TextSecondaryBrush" Color="#D8DCE4" />
    <SolidColorBrush x:Key="Theme.TextMutedBrush" Color="#98A0AE" />
    <SolidColorBrush x:Key="Theme.TextDisabledBrush" Color="#8490A0" />
    <SolidColorBrush x:Key="Theme.AccentBrush" Color="#58B6EA" />
    <SolidColorBrush x:Key="Theme.AccentTextBrush" Color="#58B6EA" />
    <SolidColorBrush x:Key="Theme.AccentTintBrush" Color="#294558" />
    <SolidColorBrush x:Key="Theme.AccentForegroundBrush" Color="#15212A" />
    <SolidColorBrush x:Key="Theme.PrimaryButtonBrush" Color="#B4C3D0" />
    <SolidColorBrush x:Key="Theme.PrimaryHoverBrush" Color="#C5D3DF" />
    <SolidColorBrush x:Key="Theme.PrimaryPressedBrush" Color="#9FB0BF" />
    <SolidColorBrush x:Key="Theme.PrimaryBorderBrush" Color="#D0DCE5" />
    <SolidColorBrush x:Key="Theme.PrimaryForegroundBrush" Color="#141619" />

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Theme.CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- The system template paints its own light icon gutter even when Background is dark. -->
                    <Border x:Name="MenuChrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"
                                            Grid.IsSharedSizeScope="True" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border x:Name="MenuSeparator" Height="1" Margin="32,3,6,3"
                            Background="{DynamicResource Theme.BorderBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator" BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}" />
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="MenuBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="MenuIcon" Content="{TemplateBinding Icon}" VerticalAlignment="Center" />
                                <Path x:Name="MenuCheck" Data="M 1,5 L 4,8 L 10,2" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                      Width="11" Height="10" VerticalAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{TemplateBinding InputGestureText}" />
                                    <Path x:Name="SubmenuArrow" Data="M 0,0 L 4,4 L 0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                                          Width="4" Height="8" Margin="8,0,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False">
                            <Border Background="{DynamicResource Theme.CardBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="4">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="MenuIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MenuCheck" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource Theme.HoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}" />
    </Style>
</ResourceDictionary>
