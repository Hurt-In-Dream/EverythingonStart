<Window x:Class="EverythingonStart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:EverythingonStart.Models"
        Title="EverythingonStart"
        Width="854"
        Height="886"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Inter, Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Geometry x:Key="MingCuteSettings4LineGeometry">F0 M13.414,2.1 A2,2 0 0 0 10.586,2.1 L8.686,4 H6 A2,2 0 0 0 4,6 V8.686 L2.1,10.586 A2,2 0 0 0 2.1,13.414 L4,15.314 V18 A2,2 0 0 0 6,20 H8.686 L10.586,21.9 A2,2 0 0 0 13.414,21.9 L15.314,20 H18 A2,2 0 0 0 20,18 V15.314 L21.9,13.414 A2,2 0 0 0 21.9,10.586 L20,8.686 V6 A2,2 0 0 0 18,4 H15.314 L13.414,2.1 Z M12,3.515 L14.182,5.697 A1,1 0 0 0 14.889,5.99 H18 V9.111 A1,1 0 0 0 18.293,9.818 L20.485,12 L18.293,14.182 A1,1 0 0 0 18,14.889 V18 H14.889 A1,1 0 0 0 14.182,18.293 L12,20.485 L9.818,18.293 A1,1 0 0 0 9.111,18 H6 V14.889 A1,1 0 0 0 5.707,14.182 L3.515,12 L5.707,9.818 A1,1 0 0 0 6,9.111 V6 H9.111 A1,1 0 0 0 9.818,5.697 L12,3.515 Z M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 Z M12,10.5 A1.5,1.5 0 1 1 12,13.5 A1.5,1.5 0 1 1 12,10.5 Z</Geometry>

        <!-- 现代深色滚动条样式 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="6">
                            <Track Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#44FFFFFF" Margin="1,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部胶囊标签 RadioButton 样式（带鼠标浮动高亮与上浮动画） -->
        <Style x:Key="CategoryPillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E4E6EB" />
            <Setter Property="Background" Value="#2D2F34" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1"
                                BorderBrush="#14FFFFFF"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="PillTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#3B3E46" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#2AFFFFFF" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-1.8"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.035"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.035"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#B4C3D0" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#D0DCE5" />
                                <Setter Property="Foreground" Value="#141619" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部胶囊动作按钮样式（与分类胶囊视觉一致，带鼠标浮动高亮与上浮动画） -->
        <Style x:Key="CategoryActionPillButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#E4E6EB" />
            <Setter Property="Background" Value="#2D2F34" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1"
                                BorderBrush="#14FFFFFF"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="PillTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#3B3E46" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#2AFFFFFF" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-1.8"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.035"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.035"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#B4C3D0" />
                                <Setter Property="Foreground" Value="#141619" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标按钮样式（带鼠标浮动高亮与微缩放动画） -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D4D7DD" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="BtnTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#32353D" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#22FFFFFF" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-1.2"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.06"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.06"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#24262C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右侧详情面板快捷操作按钮样式（带鼠标浮动高亮卡片与平滑位移） -->
        <Style x:Key="ActionRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#ECEEF2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="RowScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="RowTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#34373F" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#22FFFFFF" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RowTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-1.5"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RowTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="2"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RowScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.012"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RowScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.012"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RowTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RowTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RowScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RowScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#282A30" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 根容器：将静态阴影层与动态内容层分离，避免子控件悬停/打字触发整窗高斯阴影重绘 -->
    <Grid x:Name="PopupRootContainer" RenderTransformOrigin="0.5,1.0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopupScaleTransform" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="PopupSlideTransform" X="0" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- 静态缓存阴影层（仅在尺寸改变时光栅化一次） -->
        <Border Margin="10"
                CornerRadius="12"
                Background="#FF1F2023"
                IsHitTestVisible="False">
            <Border.CacheMode>
                <BitmapCache RenderAtScale="1" SnapsToDevicePixels="True" />
            </Border.CacheMode>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="0.48"
                                  Color="#000000"
                                  RenderingBias="Performance" />
            </Border.Effect>
        </Border>

        <!-- 外层玻璃主容器（无 Effect，所有子元素交互直接硬件加速渲染） -->
        <Border x:Name="RootCardBorder"
                Margin="10"
                CornerRadius="12"
                Background="#F21F2023"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1">

        <Grid x:Name="RootContentGrid" Margin="22,17,22,18">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="ContentUiScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 第一行：顶部圆角搜索框 -->
            <Border x:Name="SearchInputBorder"
                    Grid.Row="0"
                    Height="38"
                    CornerRadius="19"
                    Background="#18191B"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Padding="14,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 放大镜图标 -->
                    <Path Grid.Column="0"
                          Width="15"
                          Height="15"
                          Stretch="Uniform"
                          Stroke="#58B6EA"
                          StrokeThickness="1.8"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          Data="M 6.5,1 A 5.5,5.5 0 1 1 6.49,1 M 10.5,10.5 L 14.5,14.5" />

                    <!-- 输入框 -->
                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#F5F6F8"
                             CaretBrush="#58B6EA"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             TextChanged="OnSearchTextChanged" />

                    <!-- 占位提示文字 -->
                    <TextBlock x:Name="PlaceholderText"
                               Grid.Column="1"
                               Text="在此处输入以搜索文件 (Everything)、应用、设置与 Web..."
                               Foreground="#7A7E87"
                               FontSize="13.5"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />

                    <!-- 清除按钮 -->
                    <Button x:Name="ClearSearchButton"
                            Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            Width="24"
                            Height="24"
                            Visibility="Collapsed"
                            Click="OnClearSearchClick"
                            ToolTip="清空搜索内容 (Esc)">
                        <Path Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Stroke="#A6ABB4"
                              StrokeThickness="1.6"
                              Data="M 1,1 L 9,9 M 9,1 L 1,9" />
                    </Button>
                </Grid>
            </Border>

            <!-- 第二行：分类胶囊栏与右侧设置按钮 -->
            <Grid Grid.Row="1" Margin="0,12,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 返回全部 / 关闭窗口按钮 -->
                <Button x:Name="BackOrCloseButton"
                        Grid.Column="0"
                        Style="{StaticResource IconButtonStyle}"
                        Margin="0,0,6,0"
                        Click="OnBackToAllCategoryClick"
                        ToolTip="在其他分类页返回“全部”，在“全部”页直接关闭搜索窗口">
                    <Path Width="13"
                          Height="13"
                          Stretch="Uniform"
                          Stroke="#D6D9E0"
                          StrokeThickness="1.6"
                          Data="M 13,6.5 L 1,6.5 M 6,1.5 L 1,6.5 L 6,11.5" />
                </Button>

                <!-- 分类胶囊列表 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TabAll" Content="全部" Padding="11,5" Margin="0,0,5,0" IsChecked="True" Style="{StaticResource CategoryPillStyle}" Tag="{x:Static models:SearchCategory.All}" Checked="OnCategoryTabChecked" />
                    <RadioButton x:Name="TabApps" Content="应用" Padding="11,5" Margin="0,0,5,0" Style="{StaticResource CategoryPillStyle}" Tag="{x:Static models:SearchCategory.Apps}" Checked="OnCategoryTabChecked" />
                    <RadioButton x:Name="TabDocs" Content="文档" Padding="11,5" Margin="0,0,5,0" Style="{StaticResource CategoryPillStyle}" Tag="{x:Static models:SearchCategory.Documents}" Checked="OnCategoryTabChecked" />
                    <RadioButton x:Name="TabWeb" Content="Web" Padding="11,5" Margin="0,0,5,0" Style="{StaticResource CategoryPillStyle}" Tag="{x:Static models:SearchCategory.Web}" Checked="OnCategoryTabChecked" />
                    <RadioButton x:Name="TabSettings" Content="设置" Padding="11,5" Margin="0,0,5,0" Style="{StaticResource CategoryPillStyle}" Tag="{x:Static models:SearchCategory.Settings}" Checked="OnCategoryTabChecked" />
                    <RadioButton x:Name="TabFolders" Content="文件夹" Padding="11,5" Margin="0,0,5,0" Style="{StaticResource CategoryPillStyle}" Tag="{x:Static models:SearchCategory.Folders}" Checked="OnCategoryTabChecked" />
                    <RadioButton x:Name="TabPhotos" Content="照片" Padding="11,5" Margin="0,0,5,0" Style="{StaticResource CategoryPillStyle}" Tag="{x:Static models:SearchCategory.Photos}" Checked="OnCategoryTabChecked" />
                    <Button x:Name="BtnMoreEverything"
                            Content="更多"
                            Padding="11,5"
                            Margin="0,0,4,0"
                            Style="{StaticResource CategoryActionPillButtonStyle}"
                            Click="OnOpenInEverythingClick"
                            ToolTip="跳转到 Everything 主窗口 (Shift+Enter)" />
                </StackPanel>

                <!-- 右侧：排序方式、筛选选项、设置中心与更多菜单 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="EngineStatusBadge" Visibility="Collapsed" />

                    <!-- 排序方式按钮 -->
                    <Button x:Name="SortSelectorButton"
                            Style="{StaticResource CategoryActionPillButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,5,0"
                            Click="OnSortSelectorButtonClick"
                            ToolTip="切换 Everything 搜索结果排序方式">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="11"
                                  Height="11"
                                  Stretch="Uniform"
                                  Stroke="#58B6EA"
                                  StrokeThickness="1.5"
                                  Margin="0,0,5,0"
                                  VerticalAlignment="Center"
                                  Data="M 3,1 L 3,11 M 1,8.5 L 3,11 L 5,8.5 M 9,11 L 9,1 M 7,3.5 L 9,1 L 11,3.5" />
                            <TextBlock x:Name="SortButtonLabel"
                                       Text="排序: 智能"
                                       FontSize="11.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 筛选选项按钮 -->
                    <Button x:Name="FilterSelectorButton"
                            Style="{StaticResource CategoryActionPillButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,5,0"
                            Click="OnFilterSelectorButtonClick"
                            ToolTip="切换文件类型筛选器模式、附加文件类型与匹配开关">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="11"
                                  Height="11"
                                  Stretch="Uniform"
                                  Stroke="#58B6EA"
                                  StrokeThickness="1.5"
                                  Margin="0,0,5,0"
                                  VerticalAlignment="Center"
                                  Data="M 1,1.5 L 11,1.5 L 7,6 L 7,10.5 L 5,9.5 L 5,6 Z" />
                            <TextBlock x:Name="FilterButtonLabel"
                                       Text="筛选: 默认"
                                       FontSize="11.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 设置中心按钮 (mingcute:settings-4-line) -->
                    <Button x:Name="SettingsWindowButton"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="0,0,2,0"
                            Click="OnSettingsWindowButtonClick"
                            ToolTip="打开设置中心（自定义各子选项文件类型、排序与外观）">
                        <Path Width="15"
                              Height="15"
                              Stretch="Uniform"
                              Fill="#D6D9E0"
                              Data="{StaticResource MingCuteSettings4LineGeometry}" />
                    </Button>

                    <!-- 快捷选项菜单 -->
                    <Button x:Name="OptionsMenuButton"
                            Style="{StaticResource IconButtonStyle}"
                            Click="OnOptionsMenuButtonClick"
                            ToolTip="快捷选项菜单">
                        <Path Width="15"
                              Height="4"
                              Stretch="Uniform"
                              Fill="#D6D9E0"
                              Data="M 2,2 A 1.5,1.5 0 1 1 1.99,2 M 8,2 A 1.5,1.5 0 1 1 7.99,2 M 14,2 A 1.5,1.5 0 1 1 13.99,2" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 第三行：左右双栏主面板 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45.5*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="54.5*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：分组与搜索结果虚拟化列表 -->
                <ListBox x:Name="ResultsListBox"
                         Grid.Column="0"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionChanged="OnResultsSelectionChanged"
                         MouseDoubleClick="OnResultsMouseDoubleClick">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SearchListEntry}">
                            <Grid>
                                <!-- 分组标题行 -->
                                <Border Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}"
                                        Padding="4,10,6,5"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        MouseLeftButtonUp="OnSectionHeaderMouseLeftButtonUp">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding HeaderTitle}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F3F4F6" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding HeaderCountBadge}"
                                                   FontSize="11.5"
                                                   Foreground="#8C919C"
                                                   VerticalAlignment="Bottom"
                                                   Margin="8,0,0,1" />
                                        <Path Grid.Column="3"
                                              Visibility="{Binding CanExpandCategory, Converter={StaticResource BoolToVis}}"
                                              Width="6"
                                              Height="10"
                                              Stretch="Uniform"
                                              Stroke="#9BA1AE"
                                              StrokeThickness="1.5"
                                              VerticalAlignment="Center"
                                              Data="M 1,1 L 5,5 L 1,9" />
                                    </Grid>
                                </Border>

                                <!-- 结果条目行（带鼠标浮动高亮卡片与图标上浮微缩放动画） -->
                                <Border x:Name="ItemRowBorder"
                                        CornerRadius="6"
                                        Padding="10,7"
                                        Background="Transparent"
                                        BorderThickness="1"
                                        BorderBrush="Transparent"
                                        Cursor="Hand"
                                        RenderTransformOrigin="0.5,0.5"
                                        MouseLeftButtonUp="OnResultRowMouseLeftButtonUp">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="ItemRowScale" ScaleX="1" ScaleY="1" />
                                            <TranslateTransform x:Name="ItemRowTranslate" X="0" Y="0" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBestMatchCard}" Value="True">
                                                    <Setter Property="Background" Value="#2B2D31" />
                                                    <Setter Property="BorderBrush" Value="#14FFFFFF" />
                                                    <Setter Property="Padding" Value="12,10" />
                                                    <Setter Property="Margin" Value="0,2,0,4" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                    <Setter Property="Background" Value="#32353E" />
                                                    <Setter Property="BorderBrush" Value="#24FFFFFF" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                 To="-1.5"
                                                                                 Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                                                 To="2"
                                                                                 Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                 To="1.012"
                                                                                 Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                 To="1.012"
                                                                                 Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                 To="0"
                                                                                 Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                                                 To="0"
                                                                                 Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                 To="1"
                                                                                 Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                 To="1"
                                                                                 Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#363942" />
                                                    <Setter Property="BorderBrush" Value="#28FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 左侧选中指示竖条 -->
                                        <Border Width="3"
                                                Height="16"
                                                CornerRadius="1.5"
                                                Background="#58B6EA"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="-10,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- 条目图标 -->
                                        <Image x:Name="ItemIconImage"
                                               Grid.Column="0"
                                               Source="{Binding Item.SmallIcon}"
                                               Width="22"
                                               Height="22"
                                               Margin="2,0,11,0"
                                               VerticalAlignment="Center"
                                               RenderTransformOrigin="0.5,0.5"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                    <TranslateTransform X="0" Y="0" />
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                         To="1.10"
                                                                                         Duration="0:0:0.15">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                         To="1.10"
                                                                                         Duration="0:0:0.15">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                         To="-1.2"
                                                                                         Duration="0:0:0.15">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                         To="1"
                                                                                         Duration="0:0:0.18">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                         To="1"
                                                                                         Duration="0:0:0.18">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                         To="0"
                                                                                         Duration="0:0:0.18">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- 条目文字 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Item.Title}"
                                                       Foreground="#F2F4F7"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Text="{Binding Item.Subtitle}"
                                                       Foreground="#989EA9"
                                                       FontSize="11.5"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBestMatchCard}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Item.FormattedModifiedLine}"
                                                       Foreground="#828894"
                                                       FontSize="11"
                                                       Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsBestMatchCard}" Value="True" />
                                                                    <Condition Binding="{Binding Item.HasModifiedLine}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 中间细分隔线 -->
                <Border Grid.Column="1"
                        Width="1"
                        Background="#1FFFFFFF"
                        HorizontalAlignment="Center"
                        Margin="0,4" />

                <!-- 右栏：选中项详情与快捷操作卡片（还原截图右侧面板） -->
                <Border x:Name="PreviewCardBorder"
                        Grid.Column="2"
                        CornerRadius="8"
                        Background="#28292D"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="1"
                        Padding="22,16,22,16">
                    <Grid x:Name="PreviewContentGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部居中大图标与文件名称（还原如图所示的圆角浮动高亮磁贴与上浮动画） -->
                        <Border x:Name="PreviewHeroCardBorder"
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                CornerRadius="8"
                                Padding="26,14,26,14"
                                Margin="0,0,0,12"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Cursor="Hand"
                                ToolTip="点击直接打开选中项 (Enter)"
                                RenderTransformOrigin="0.5,0.5"
                                MouseLeftButtonUp="OnActionOpenClick">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                    <TranslateTransform X="0" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#34363D" />
                                            <Setter Property="BorderBrush" Value="#26FFFFFF" />
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                         To="-2.5"
                                                                         Duration="0:0:0.16">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                         To="1.02"
                                                                         Duration="0:0:0.16">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                         To="1.02"
                                                                         Duration="0:0:0.16">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                         To="0"
                                                                         Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                         To="1"
                                                                         Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                         To="1"
                                                                         Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel HorizontalAlignment="Center">
                                <Image x:Name="PreviewIconImage"
                                       Width="64"
                                       Height="64"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12"
                                       RenderTransformOrigin="0.5,0.5"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                            <TranslateTransform X="0" Y="0" />
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PreviewHeroCardBorder, Path=IsMouseOver}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                 To="1.08"
                                                                                 Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                 To="1.08"
                                                                                 Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                 To="-2.0"
                                                                                 Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                 To="1"
                                                                                 Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                 To="1"
                                                                                 Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                 To="0"
                                                                                 Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <TextBlock x:Name="PreviewTitleText"
                                           Text="选择条目查看详情"
                                           Foreground="#F5F6F8"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="310" />

                                <TextBlock x:Name="PreviewSubtitleText"
                                           Text=""
                                           Foreground="#A0A6B2"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="310"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 中部文件位置、修改时间、状态属性区 -->
                        <StackPanel Grid.Row="1">
                            <Border Height="1" Background="#24FFFFFF" Margin="0,0,0,14" />

                            <Grid Margin="2,0,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="位置"
                                           Foreground="#949AA6"
                                           FontSize="12" />
                                <TextBlock x:Name="PreviewLocationText"
                                           Grid.Column="1"
                                           Text="-"
                                           Foreground="#D5D8DF"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           MaxHeight="54" />
                            </Grid>

                            <Grid Margin="2,0,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="上次修改时间"
                                           Foreground="#949AA6"
                                           FontSize="12" />
                                <TextBlock x:Name="PreviewModifiedText"
                                           Grid.Column="1"
                                           Text="-"
                                           Foreground="#D5D8DF"
                                           FontSize="12" />
                            </Grid>

                            <Grid Margin="2,0,2,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="状态"
                                           Foreground="#949AA6"
                                           FontSize="12" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="#38BDF8"
                                             VerticalAlignment="Center"
                                             Margin="0,0,7,0" />
                                    <TextBlock x:Name="PreviewStatusText"
                                               Text="-"
                                               Foreground="#D5D8DF"
                                               FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#24FFFFFF" Margin="0,0,0,10" />
                        </StackPanel>

                        <!-- 底部快捷操作列表（还原截图：打开、管理员取得所有权、打开文件位置、复制路径） -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Top">
                            <Button x:Name="BtnActionOpen"
                                    Style="{StaticResource ActionRowButtonStyle}"
                                    Click="OnActionOpenClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          Stroke="#D6D9E0"
                                          StrokeThickness="1.4"
                                          HorizontalAlignment="Left"
                                          Data="M 8,1 L 13,1 L 13,6 M 13,1 L 6,8 M 11,8.5 L 11,12.5 L 1.5,12.5 L 1.5,3 L 5.5,3" />
                                    <TextBlock Grid.Column="1" Text="打开" FontSize="12.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Enter" FontSize="11" Foreground="#7A808C" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button x:Name="BtnActionAdmin"
                                    Style="{StaticResource ActionRowButtonStyle}"
                                    Click="OnActionAdminClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          Stroke="#D6D9E0"
                                          StrokeThickness="1.4"
                                          HorizontalAlignment="Left"
                                          Data="M 7,1 L 13,3.5 L 13,7.5 C 13,10.8 10.4,13.4 7,14.5 C 3.6,13.4 1,10.8 1,7.5 L 1,3.5 Z" />
                                    <TextBlock x:Name="AdminActionLabel" Grid.Column="1" Text="管理员取得所有权" FontSize="12.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Ctrl+Shift+Enter" FontSize="11" Foreground="#7A808C" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button x:Name="BtnActionOpenLocation"
                                    Style="{StaticResource ActionRowButtonStyle}"
                                    Click="OnActionOpenLocationClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          Stroke="#D6D9E0"
                                          StrokeThickness="1.4"
                                          HorizontalAlignment="Left"
                                          Data="M 1,3 L 5.5,3 L 7,5 L 13.5,5 L 13.5,12.5 L 1,12.5 Z" />
                                    <TextBlock Grid.Column="1" Text="打开文件位置" FontSize="12.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Ctrl+Enter" FontSize="11" Foreground="#7A808C" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button x:Name="BtnActionCopyPath"
                                    Style="{StaticResource ActionRowButtonStyle}"
                                    Click="OnActionCopyPathClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          Stroke="#D6D9E0"
                                          StrokeThickness="1.4"
                                          HorizontalAlignment="Left"
                                          Data="M 4.5,4.5 L 12.5,4.5 L 12.5,13.5 L 4.5,13.5 Z M 2,10.5 L 2,1.5 L 10,1.5" />
                                    <TextBlock x:Name="CopyPathActionLabel" Grid.Column="1" Text="复制路径" FontSize="12.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Ctrl+Shift+C" FontSize="11" Foreground="#7A808C" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
